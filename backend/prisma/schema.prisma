generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Listing {
  id           Int      @id @default(autoincrement())
  name         String
  postcode     String
  apartment_type String
  rent         Float
  status       String
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  lastname     String
  role         String
  email        String   @unique
  password     String
  status       String   @default("pending")
}
