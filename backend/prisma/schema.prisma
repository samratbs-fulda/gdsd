generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Listing {
  id              Int               @id @default(autoincrement())
  landlord        User              @relation(fields: [landlordId], references: [id]) 
  landlordId      Int               
  title           String    
  description     String  
  type            ApartmentType  
  availableFrom   DateTime  
  availableTill   DateTime  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @default(now())
  status          ListingStatus     @default(PENDING)
  coldRent        Float
  deposit         Float
  heatingCost     Float
  additionalCosts Float
  warmRent        Float
  size            Float
  floor           Int
  totalRooms      Int
  freeRooms       Int
  energyRating    String
  furnished       Furnished
  address         Address?           
  amenities       Amenities?         
  documents       Documents?         
}

model Address {
  id               Int       @id @default(autoincrement())
  listing          Listing   @relation(fields: [listingId], references: [id]) 
  listingId        Int       @unique
  street           String
  postalCode       Int
  houseNumber      Int
  latitude         Float
  longitude        Float
  distanceFromUni  Float
}

model Amenities {
  id                          Int       @id @default(autoincrement())
  listing                     Listing   @relation(fields: [listingId], references: [id]) 
  listingId                   Int       @unique
  kitchenFitted               Boolean
  petsAllowed                 Boolean
  parkingAvailable            Boolean
  balconyAvailable            Boolean
  gardenAvailable             Boolean
  wifiAvailable               Boolean
  storageAvailable            Boolean
  smokingAllowed              Boolean
  dishWasherAvailalbe         Boolean
  washingMachineAvailable     Boolean
  tvCableIncluded             Boolean
}

model Documents {
  id                          Int       @id @default(autoincrement())
  listing                     Listing   @relation(fields: [listingId], references: [id]) 
  listingId                   Int       @unique
  proofOfIncome               Boolean
  proofOfIdentity             Boolean
  shufaCreditReport           Boolean
  parentalGuarantee           Boolean
}

model User {
  id           Int          @id @default(autoincrement())
  username     String
  email        String
  password     String
  firstname    String
  lastname     String
  role         Role
  listings     Listing[]
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now())
}

enum ApartmentType {
  SINGLE
  SHARED
  SUBLET
}

enum Furnished {
  FURNISHED
  PARTIALLY
  NONFURNISHED
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  DELETED
}

enum UserStatus {
  ACTIVE
  BANNED
  DELETED
}

enum Role {
  STUDENT
  LANDLORD
  MODERATOR
}
