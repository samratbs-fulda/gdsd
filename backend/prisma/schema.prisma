generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Listing {
  id              Int           @id @default(autoincrement())
  landlord        User          @relation(fields: [landlordId], references: [id])
  landlordId      Int
  title           String
  description     String
  type            ApartmentType
  availableFrom   DateTime
  availableTill   DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now())
  status          ListingStatus @default(PENDING)
  coldRent        Float
  deposit         Float
  heatingCost     Float
  additionalCosts Float
  warmRent        Float
  size            Float
  floor           Int
  totalRooms      Int
  freeRooms       Int
  energyRating    String
  furnished       Furnished
  street          String
  postalCode      String
  houseNumber     Int
  latitude        Float
  longitude       Float
  distanceFromUni Float
  amenities       Amenities?
  documents       Documents?
  Chat Chat[]
}

model Amenities {
  id                      Int     @id @default(autoincrement())
  listing                 Listing @relation(fields: [listingId], references: [id])
  listingId               Int     @unique
  kitchenFitted           Boolean
  petsAllowed             Boolean
  parkingAvailable        Boolean
  balconyAvailable        Boolean
  gardenAvailable         Boolean
  wifiAvailable           Boolean
  storageAvailable        Boolean
  smokingAllowed          Boolean
  dishWasherAvailalbe     Boolean
  washingMachineAvailable Boolean
  tvCableIncluded         Boolean
}

model Documents {
  id                Int     @id @default(autoincrement())
  listing           Listing @relation(fields: [listingId], references: [id])
  listingId         Int     @unique
  proofOfIncome     Boolean
  proofOfIdentity   Boolean
  shufaCreditReport Boolean
  parentalGuarantee Boolean
}

model User {
  id        Int        @id @default(autoincrement())
  username  String     @unique
  email     String     @unique
  password  String
  firstname String
  lastname  String
  role      Role
  listings  Listing[]
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  profile   Profile?


  // ChatUser1 Chat[] @relation("user1Chats")

  // ChatUser2 Chat[] @relation("user2Chats")

  Messages Messages[]

  ChatParticipant ChatParticipant[]

  GroupMemberships GroupMember[] @relation("groupMembership")

  CreatorOfGroups Group[] @relation("creatorOfGroup")
}

model Chat {
  id Int @id @default(autoincrement())
  listingId Int 
  listing Listing @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())
  ChatParticipant ChatParticipant[]

  Messages Messages[]
}

model ChatParticipant {
  id Int @id @default(autoincrement())
  chatId Int
  chat Chat @relation(fields: [chatId], references: [id])
  userId Int
  user User @relation(fields: [userId], references: [id])
}

model Messages {
  id         Int      @id @default(autoincrement())
  chat       Chat     @relation(fields: [chatId], references: [id])
  chatId     Int
  sender     User     @relation(fields: [senderId], references: [id])
  senderId   Int
  content    String
  createdAt  DateTime @default(now())
}

model Profile {
  id            Int     @id @default(autoincrement())
  dob           DateTime?
  age           Int?
  gender        String?
  nationality   String?
  phone         String?  @unique
  bio           String?
  user          User    @relation(fields: [userId], references: [id])
  userId        Int     @unique
}



model Group {
  id            Int       @id @default(autoincrement())
  creator       User      @relation("creatorOfGroup", fields: [creatorId], references: [id])
  creatorId     Int       
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now())

  members GroupMember[]
}

model GroupMember {
  group    Group  @relation(fields: [groupId], references: [id])
  groupId  Int
  student         User          @relation("groupMembership", fields: [studentId], references: [id])
  studentId       Int
  status          GroupMemberStatus  @default(PENDING)

  @@id([groupId, studentId])
}

enum ApartmentType {
  SINGLE
  SHARED
  SUBLET
}

enum Furnished {
  FURNISHED
  PARTIALLY
  NONFURNISHED
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  DELETED
}

enum UserStatus {
  ACTIVE
  BANNED
  DELETED
}

enum Role {
  STUDENT
  LANDLORD
  MODERATOR
}

enum GroupMemberStatus {
  PENDING
  ACCEPTED
}
