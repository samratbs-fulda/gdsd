generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Listing {
  id              Int           @id @default(autoincrement())
  landlord        User          @relation(fields: [landlordId], references: [id])
  landlordId      Int
  title           String
  description     String
  type            ApartmentType
  availableFrom   DateTime
  availableTill   DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now())
  status          ListingStatus @default(PENDING)
  coldRent        Float
  deposit         Float
  heatingCost     Float
  additionalCosts Float
  warmRent        Float
  size            Float
  floor           Int
  totalRooms      Int
  freeRooms       Int
  energyRating    String
  furnished       Furnished
  street          String
  postalCode      Int
  houseNumber     Int
  latitude        Float
  longitude       Float
  distanceFromUni Float
  amenities       Amenities?
  documents       Documents?
}

model Amenities {
  id                      Int     @id @default(autoincrement())
  listing                 Listing @relation(fields: [listingId], references: [id])
  listingId               Int     @unique
  kitchenFitted           Boolean
  petsAllowed             Boolean
  parkingAvailable        Boolean
  balconyAvailable        Boolean
  gardenAvailable         Boolean
  wifiAvailable           Boolean
  storageAvailable        Boolean
  smokingAllowed          Boolean
  dishWasherAvailalbe     Boolean
  washingMachineAvailable Boolean
  tvCableIncluded         Boolean
}

model Documents {
  id                Int     @id @default(autoincrement())
  listing           Listing @relation(fields: [listingId], references: [id])
  listingId         Int     @unique
  proofOfIncome     Boolean
  proofOfIdentity   Boolean
  shufaCreditReport Boolean
  parentalGuarantee Boolean
}

model User {
  id        Int        @id @default(autoincrement())
  username  String     @unique
  email     String     @unique
  password  String
  firstname String
  lastname  String
  role      Role
  listings  Listing[]
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now())
  profile   Profile?


  ChatUser1 Chat[] @relation("user1Chats")

  ChatUser2 Chat[] @relation("user2Chats")

  Messages Messages[]
}



model Chat {
  id         Int      @id @default(autoincrement())
  user1      User     @relation("user1Chats", fields: [user1Id], references: [id])
  user1Id    Int
  user2      User     @relation("user2Chats", fields: [user2Id], references: [id])
  user2Id    Int
  createdAt  DateTime @default(now())

  Messages Messages[]
}

model Profile {
  id            Int     @id @default(autoincrement())
  age           Int
  gender        String
  nationality   String
  phone         String  @unique
  bio           String
  user          User    @relation(fields: [userId], references: [id])
  userId        Int     @unique
}

model Messages {
  id         Int      @id @default(autoincrement())
  chat       Chat     @relation(fields: [chatId], references: [id])
  chatId     Int
  sender     User     @relation(fields: [senderId], references: [id])
  senderId   Int
  content    String
  createdAt  DateTime @default(now())
}

enum ApartmentType {
  SINGLE
  SHARED
  SUBLET
}

enum Furnished {
  FURNISHED
  PARTIALLY
  NONFURNISHED
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  DELETED
}

enum UserStatus {
  ACTIVE
  BANNED
  DELETED
}

enum Role {
  STUDENT
  LANDLORD
  MODERATOR
}
